ENABLE_TELEGRAM_BOT_UI=true
# Manual VK reports/PPTX work without background collection or automatic alerts.
ENABLE_BACKGROUND_MONITORS=false
ENABLE_VK_MONITOR=true
ENABLE_TELEGRAM_MONITOR=false
ENABLE_REVIEWS_MONITOR=false

FAIL_FAST=false
REQUIRE_VK=false
REQUIRE_TELETHON=false

BOT_TOKEN=123456:replace_me
# Telegram Bot API only; leave empty if VPN/routing already handles Telegram.
BOT_PROXY_URL=
ADMIN_IDS=123456789

DATABASE_PATH=data/argus.sqlite3
ALERT_CHAT_ID=
ALERTS_VK_ENABLED=true
ALERTS_VK_POSTS_ENABLED=true
ALERTS_VK_COMMENTS_ENABLED=true
ALERTS_TELEGRAM_ENABLED=true
ALERTS_TELEGRAM_POSTS_ENABLED=true
ALERTS_TELEGRAM_COMMENTS_ENABLED=true
ALERTS_TELEGRAM_KEYWORDS_ENABLED=true
ALERTS_REVIEWS_ENABLED=true

REVIEWS_POLL_INTERVAL_SECONDS=900
REVIEWS_REQUEST_PAUSE_SECONDS=3.0
REVIEWS_FETCH_PAGE_SIZE=10
REVIEWS_MAX_CATCHUP_REVIEWS=50
REVIEWS_ERROR_ALERT_THRESHOLD=3
REVIEWS_MAX_BACKOFF_SECONDS=7200

VK_GROUP_TOKEN=
VK_USER_ACCESS_TOKEN=
# App service key for read-only likes reports; takes priority in likes collection.
VK_SERVICE_ACCESS_TOKEN=
# Optional VK website token. For manual likes reports only; highest priority.
VK_WEB_ACCESS_TOKEN=
# HTTP(S) forward proxy for VK login browser and likes reports, separate from Telegram.
VK_PROXY_URL=
# Optional HTTPS origin for the phone login helper; empty disables its listener/browser.
VK_AUTH_PUBLIC_URL=
VK_AUTH_PORT=8788
# For a VPN namespace, bind to its private veth IP reachable by your reverse proxy.
VK_AUTH_BIND_HOST=127.0.0.1
# Legacy alias for VK_GROUP_TOKEN. Prefer VK_GROUP_TOKEN for new configs.
VK_ACCESS_TOKEN=
VK_GROUP_ID=
VK_MONITOR_MODE=longpoll
VK_ENABLE_POLLING_FALLBACK=true
VK_RECENT_POSTS_LIMIT=15
VK_COMMENTS_POLL_INTERVAL_SECONDS=2700
VK_POSTS_POLL_INTERVAL_SECONDS=900
VK_API_VERSION=5.199

TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=argus_user
TG_SESSION_DIR=sessions
TELEGRAM_PHONE=

POLL_INTERVAL_SECONDS=60
SOURCE_SYNC_PAUSE_SECONDS=2
SYNC_LIMIT=20
INITIAL_BOOTSTRAP_LIMIT=1
COMMENTS_LIMIT_PER_POST=100
REACTIONS_SYNC_LIMIT=50
TG_DISCUSSION_FETCH_LIMIT=20
TG_TRACKED_POSTS_LIMIT=20
TG_COMMENT_ALERTS_PER_CYCLE=10
TG_REACTIONS_SYNC_INTERVAL_SECONDS=1800
FLOOD_WAIT_SMALL_SECONDS=60
TELEGRAM_CATCHUP_LIMIT=200
TELEGRAM_ANALYSIS_QUEUE_LIMIT=1000

OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_PROXY_URL=
REVIEWS_PROXY_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT=30
LLM_RISK_ANALYSIS_ENABLED=true
LLM_ANALYZE_ALL_MESSAGES=true
LLM_BATCH_SIZE=10
LLM_MAX_CONCURRENT_REQUESTS=2
LLM_ALERT_MIN_SEVERITY=2

DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_TIME=09:00
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
